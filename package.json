{
  "name": "bhupendranegi.github.io",
  "private": true,
  "scripts": {
    "build": "npm run icons:build && npm run css:build && bundle exec jekyll build",
    "icons:build": "node bin/build-icons.mjs",
    "css:build": "tailwindcss -i ./assets/css/tailwind.css -o ./assets/css/version-3.css --minify",
    "css:watch": "tailwindcss -i ./assets/css/tailwind.css -o ./assets/css/version-3.css --watch",
    "dev": "./bin/dev",
    "setup": "./bin/setup",
    "lint": "./bin/lint",
    "lint:fix": "./bin/lint --fix",
    "lint:js": "eslint .",
    "lint:css": "stylelint assets/css/tailwind.css assets/css/syntax.css",
    "lint:md": "markdownlint-cli2",
    "lint:data": "prettier --check \"**/*.{json,yml,yaml}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/cli": "^4.3.0",
    "devicon": "2.16.0",
    "eslint": "^10.15.0",
    "globals": "^17.6.0",
    "js-yaml": "5.5.0",
    "lucide-static": "1.18.0",
    "markdownlint-cli2": "^0.24.1",
    "prettier": "^3.8.4",
    "stylelint": "^17.13.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.3.0"
  },
  "comments": {
    "overrides": "micromark-extension-math (via markdownlint) requires katex ^0.16.0, which is affected by GHSA-238p-pmpm-9mq7. Force the patched 0.18 line. Drop when markdownlint ships a katex >= 0.18.2 upstream."
  },
  "overrides": {
    "katex": "^0.18.2"
  }
}
